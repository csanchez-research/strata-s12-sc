# Optional. Copy to nexus.env to install packages through a Nexus PyPI proxy.
# Without nexus.env the build and the container use PyPI directly.
# nexus.env is not versioned (it may hold credentials).
# Replace host and repository with your own Nexus values.
PIP_INDEX_URL=http://nexus.example:8081/repository/pypi-proxy/simple
PIP_TRUSTED_HOST=nexus.example
UV_DEFAULT_INDEX=http://nexus.example:8081/repository/pypi-proxy/simple
