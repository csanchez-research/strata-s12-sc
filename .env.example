# Optional. Copy to .env next to docker-compose.yml and keep only the lines you change.
# Docker Compose reads it when the container starts; .env is not versioned.
# Every value below is the default used when the line is absent.

# Name of the container and host port of the viewer. Change both to run a second
# copy of the project at the same time (for example the demonstration).
#SC_CONTAINER_NAME=strata-complete
#SC_SERVE_HOST_PORT=8765
# Host address the viewer port is published on. 127.0.0.1 keeps it on this computer.
#SC_SERVE_BIND=127.0.0.1

# Earth Engine: folder with the credentials file, and the file with GEE_PROJECT_ID.
#SC_EARTHENGINE_DIR=../.credentials/earthengine
#SC_GEE_ENV=gee.env

# The D_lite record. Without these two lines it is read from Zenodo by byte range.
# With a local copy: the host folder, and its path inside the container.
#SC_RECORD_HOST_DIR=D:/data/strata-s12-dlite
#SC_RECORD_DIR=/data/dlite_v2

# Where outputs live on the host.
#SC_OUT_HOST_DIR=./out
#SC_RELEASE_HOST_DIR=./out/release_all
# Outputs of another project, mounted read-only at /ro (for crosscheck).
#SC_RO_HOST_DIR=./data/ro
